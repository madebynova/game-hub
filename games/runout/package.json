{
  "name": "runout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RUNOUT - a browser game. Built with Vite + TypeScript, deployed as a static site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:multi": "tsc --noEmit && vite build --mode multifile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
